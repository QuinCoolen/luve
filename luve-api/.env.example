# ---------------------------------------------------------------------------
# Luve API environment. Copy to `.env` and adjust for local dev.
# Validated at boot by src/config/env.schema.ts — a missing/invalid value
# throws before the server starts.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5218

# Postgres. The api container talks to the "postgres" service on 5432 (set in
# docker-compose.yml). On the host, compose maps it to 5433 to avoid clashing
# with a local Postgres install — hence localhost:5433 here.
DATABASE_URL=postgresql://luve:luve@localhost:5433/luve?schema=public

# Redis. Container uses "redis":6379; host port is mapped to 6380.
REDIS_URL=redis://localhost:6380

# Auth — use a long random value in real environments.
JWT_SECRET=dev-secret-change-me-please-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Browser app origin (Next dev server) and cookie domain.
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Stripe — optional in dev. Fill in to exercise payments (Phase 6).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
