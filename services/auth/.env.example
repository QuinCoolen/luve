# Luve Auth API — copy to .env (`pnpm env:init` does it).
# Validated at boot by src/env.ts; a missing or invalid value stops the service.
DATABASE_URL=postgresql://luve:luve@localhost:5433/auth
RABBITMQ_URL=amqp://luve:luve@localhost:5673
# Set to "off" to stage events in the outbox without publishing them.
OUTBOX_RELAY=on

# Ed25519 signing key for access tokens: base64 of a PKCS#8 PEM.
# `pnpm --filter @luve/auth keys:generate` writes one to .env. When unset,
# an ephemeral key is generated at startup (tokens then die with the process;
# refresh tokens keep working, so clients just refresh).
# JWT_PRIVATE_KEY=
# JWT_KEY_ID=dev
JWT_ISSUER=luve-auth
JWT_AUDIENCE=luve
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# A rotated refresh token presented again within this window is treated as a
# concurrent refresh (two tabs), not as theft.
REFRESH_REUSE_GRACE_SECONDS=10

# Send cookies with the Secure flag (only over https).
COOKIE_SECURE=false
