# Luve Users API — copy to .env (`pnpm env:init` does it).
# Validated at boot by src/env.ts; a missing or invalid value stops the service.
DATABASE_URL=postgresql://luve:luve@localhost:5433/users
RABBITMQ_URL=amqp://luve:luve@localhost:5673

# The auth service's public keys, to check access tokens with.
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=luve-auth
JWT_AUDIENCE=luve
