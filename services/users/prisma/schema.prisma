// Users service schema: everything about a person except how they log in
// (that's the auth service). A profile is created when auth's user-registered
// event arrives (src/profiles/auth-events.consumer.ts), and deleted with
// user-deleted. The user fills it in through PATCH /users/me.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  /// The same id the user has in the auth service.
  userId    String   @id @map("user_id") @db.Uuid
  /// Chosen after registering, so empty until then.
  username  String?  @unique
  /// When the user registered.
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@map("profiles")
}
