{
  "name": "luve",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter luve-api start:dev\" \"pnpm --filter luve-web dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "openapi:export": "pnpm --filter luve-api openapi:export",
    "api:generate": "pnpm --filter luve-web api:generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
