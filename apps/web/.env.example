# Browser-side API base URL. Empty = same origin: the app is served through the
# Traefik gateway (http://localhost:8000), which also routes /api/* to the services.
NEXT_PUBLIC_API_URL=

# Server-side (getServerSideProps) API base URL. In local dev Next runs on the host
# and reaches the gateway on localhost; inside Docker use http://traefik:8000.
INTERNAL_API_URL=http://localhost:8000
