{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "prisma:generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false,
      "persistent": true
    },
    "openapi:export": {
      "dependsOn": ["build"],
      "outputs": ["openapi.json"]
    },
    "api:generate": {
      "outputs": ["src/api/generated/**"]
    }
  }
}
